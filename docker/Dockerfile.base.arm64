# Client-only Docker toolchain source. Pinned to the exact digest the
# nested-daemon image uses so both roles carry byte-identical binaries.
FROM docker@sha256:67c4114553192e9072969fc347426048cfe4192385dc762d8eb449c05e904255 AS docker-toolchain

FROM node:22-trixie@sha256:8433642fe11d391a7ff1f702352ac1b0ea3e378d3fb2c22de2b292036d79cd2c

# Replicate the 'codespace' user (uid 1000) from the devcontainers/universal
# image so Dockerfile.claude-code works unchanged on both platforms.
# The node base image ships node:node at uid/gid 1000 — rename it.
# usermod does not rewrite /etc/subuid or /etc/subgid, so the inherited
# `node:100000:65536` ranges are re-pointed at codespace here (delete then
# append, so the layer is idempotent). rootlesskit hard-fails without a
# subordinate range for the runtime user.
RUN usermod -l codespace -d /home/codespace -m node && \
    groupmod -n codespace node && \
    sed -i -e '/^node:/d' -e '/^codespace:/d' /etc/subuid /etc/subgid && \
    echo 'codespace:100000:65536' >> /etc/subuid && \
    echo 'codespace:100000:65536' >> /etc/subgid

USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    # Existing
    git git-lfs sudo socat ca-certificates curl \
    # Build tools for native extensions
    build-essential cmake pkg-config \
    # Graphics/Qt runtime + dev
    libegl1 libegl-dev libgl1 libgl-dev \
    libxkbcommon0 libxkbcommon-dev libdbus-1-3 libdbus-1-dev \
    # X11/XCB (Qt offscreen mode)
    libx11-6 libxext6 libxrender1 libxcb1 \
    libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 \
    libxcb-shape0 libxcb-xfixes0 libxcb-xkb1 libxkbcommon-x11-0 \
    # Common native Python deps
    libffi-dev libssl-dev zlib1g-dev libxml2-dev libxslt1-dev \
    # Fonts (Qt needs at least one font)
    fontconfig fonts-dejavu-core \
    # Rootless nested-daemon prerequisites: newuidmap/newgidmap (re-capped
    # below), setcap to re-cap them, and the `ip` binary rootlesskit invokes
    # for loopback setup even with --net=none.
    uidmap iproute2 libcap2-bin \
    && rm -rf /var/lib/apt/lists/*

# Re-cap the id-map helpers: file capabilities, NOT setuid-root.
# Writing a multi-range /proc/PID/uid_map needs CAP_SYS_ADMIN *in the target
# user namespace*, and the kernel grants every capability in a namespace to a
# process whose euid owns it. rootlesskit creates the namespace as uid 1000, so
# a helper that keeps euid 1000 inherits that grant. Debian ships these setuid
# root (4755): euid 0 forfeits the grant and then needs real CAP_SYS_ADMIN,
# which the agent VM's clamped bounding set (CAP_SETUID/CAP_SETGID only) does
# not have — the observed failure is `write to uid_map failed: Operation not
# permitted`. Dropping the setuid bit is required, not cosmetic: with both
# present the setuid bit still changes euid and re-breaks the grant. This
# matches the frozen nested-daemon image (mode 755 + cap_setuid/cap_setgid+ep).
RUN setcap cap_setuid+ep /usr/bin/newuidmap && \
    setcap cap_setgid+ep /usr/bin/newgidmap && \
    chmod u-s /usr/bin/newuidmap /usr/bin/newgidmap

# Grant passwordless sudo to codespace (matches devcontainers/universal behavior)
RUN echo "codespace ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/codespace && \
    chmod 0440 /etc/sudoers.d/codespace

# Initialize git-lfs
RUN git lfs install --system

# Python tooling: uv (fast package manager) and ruff (linter)
# curl is available from the apt-get install above.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    curl -LsSf https://astral.sh/ruff/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv && \
    mv /root/.local/bin/ruff /usr/local/bin/ruff && \
    rm -rf /root/.local

# Pre-install Python 3.12 so uv never needs to download it at runtime.
# Containers run with --network=none, so runtime downloads would fail.
# Install to a shared location so the codespace user can find it.
# uv uses rustls by default. Runtime sessions supply a CA-neutral image with
# a read-only per-session trust bundle and UV_NATIVE_TLS/SSL_CERT_FILE wiring.
ENV UV_NATIVE_TLS=1
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
RUN uv python install 3.12
# Install pip so agents can use `pip install` directly.
RUN apt-get update && apt-get install -y --no-install-recommends python3-pip && rm -rf /var/lib/apt/lists/*

RUN npm install -g node-gyp

# Rust toolchain (rustc, cargo) + cargo-fuzz for the vuln-discovery workflow.
# Containers run with --network=none, so the toolchain and the nightly
# channel that cargo-fuzz invokes must be baked into the image. Installed
# system-wide under /opt/rust so the codespace user inherits it via ENV.
ENV RUSTUP_HOME=/opt/rust/rustup
ENV CARGO_HOME=/opt/rust/cargo
ENV PATH=/opt/rust/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
        sh -s -- -y --no-modify-path --default-toolchain stable --profile minimal \
            --component rust-src && \
    rustup toolchain install nightly --profile minimal --component rust-src && \
    cargo install cargo-fuzz && \
    rm -rf /opt/rust/cargo/registry /opt/rust/cargo/git && \
    chmod -R a+rX /opt/rust && \
    chown -R codespace:codespace /opt/rust/rustup /opt/rust/cargo && \
    printf 'export RUSTUP_HOME=/opt/rust/rustup\nexport CARGO_HOME=/opt/rust/cargo\nexport PATH=/opt/rust/cargo/bin:$PATH\n' \
        > /etc/profile.d/rust.sh

# Playwright + Chromium: pre-install so containers work with --network=none.
# Install system deps as root, then browser to a shared path.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
RUN npx playwright install-deps chromium && \
    npx playwright install chromium && \
    chmod -R o+rx /opt/playwright-browsers

# Docker toolchain, copied verbatim from the pinned stage so the shipped bytes
# stay auditable against the source image. Only the CLI is placed on PATH; the
# daemon-side binaries (dockerd, rootlesskit, containerd, runc) stay off it and
# are reached by the in-VM bootstrap through an explicit PATH.
#
# --chown=root:root is required, not cosmetic: COPY --from preserves the source
# image's ownership, and `rootlesskit`/`vpnkit` are owned 1001:1001 there. On a
# Linux host that remaps the agent to uid 1001 the runtime user would otherwise
# OWN shipped toolchain binaries and could rewrite them.
#
# The plugins land in /usr/local/libexec/docker/cli-plugins to match the source
# layout: the copied /usr/local/bin/docker-compose is a symlink into that exact
# path, and it is one of the CLI's default system plugin directories, so both
# the symlink and plugin discovery resolve.
COPY --from=docker-toolchain --chown=root:root /usr/local/bin/ /usr/local/lib/ironcurtain-docker/bin/
COPY --from=docker-toolchain --chown=root:root /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/
RUN ln -s /usr/local/lib/ironcurtain-docker/bin/docker /usr/local/bin/docker

# /run is ext4 in the agent VM, not a tmpfs, so directories created here survive
# into the runtime. The nested-daemon API directory MUST be image-provided: the
# VM's bounding set has no CAP_CHOWN, so no runtime step can hand a 0700
# directory to the runtime user.
RUN mkdir -p /workspace /etc/ironcurtain /run/ironcurtain && \
    chown codespace:codespace /workspace /etc/ironcurtain /run/ironcurtain && \
    install -d -o codespace -g codespace -m 0700 /run/ironcurtain-docker

WORKDIR /workspace
USER codespace

# Node.js headers for native addon compilation (node-gyp).
# Must run as codespace — node-gyp caches headers in ~/.cache/node-gyp/
# and the runtime user is codespace, not root.
RUN node-gyp install
