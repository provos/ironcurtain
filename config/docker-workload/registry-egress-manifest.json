{
  "schemaVersion": 1,
  "policyId": "workload-registry-egress-v1",
  "status": "frozen",
  "origins": [
    {
      "id": "docker-hub-registry",
      "destination": { "protocol": "https:", "hostname": "registry-1.docker.io", "port": 443 },
      "operations": ["api-version", "manifest-pull", "blob-pull"],
      "perRequest": { "maxBytes": 1073741824, "maxDurationMs": 300000, "maxRedirectHops": 3 },
      "requestHeaders": { "allow": ["accept", "accept-encoding", "user-agent", "range"] }
    },
    {
      "id": "docker-hub-token",
      "destination": { "protocol": "https:", "hostname": "auth.docker.io", "port": 443 },
      "operations": ["token"],
      "tokenPaths": [{ "kind": "exact", "value": "/token" }],
      "perRequest": { "maxBytes": 1048576, "maxDurationMs": 30000, "maxRedirectHops": 0 },
      "requestHeaders": { "allow": ["accept", "accept-encoding", "user-agent"] }
    },
    {
      "id": "ghcr-registry",
      "destination": { "protocol": "https:", "hostname": "ghcr.io", "port": 443 },
      "operations": ["api-version", "manifest-pull", "blob-pull", "token"],
      "tokenPaths": [{ "kind": "exact", "value": "/token" }],
      "perRequest": { "maxBytes": 1073741824, "maxDurationMs": 300000, "maxRedirectHops": 3 },
      "requestHeaders": { "allow": ["accept", "accept-encoding", "user-agent", "range"] }
    }
  ],
  "perSession": { "maxTotalBytes": 17179869184, "maxConcurrentRequests": 8 },
  "rejectedOperations": ["push", "delete", "catalog-enumeration", "tags-enumeration"]
}
